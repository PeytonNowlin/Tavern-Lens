<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- JavaScriptCore JITs the combat simulator only with this; without it the simulator
	     is interpreted and runs about 7 times slower (Sources/SimulatorRuntime). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
